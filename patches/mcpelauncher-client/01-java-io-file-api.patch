 public:
@@ -11,9 +26,178 @@ public:
     explicit File(std::string path) : path(std::move(path)) {
     }
 
+    static bool storageDebug() {
+        static bool enabled = ::getenv("TRINITY_DEBUG_STORAGE") != nullptr;
+        return enabled;
+    }
+
     std::shared_ptr<FakeJni::JString> getPath() {
         return std::make_shared<FakeJni::JString>(path.c_str());
     }
+
+    std::shared_ptr<FakeJni::JString> getAbsolutePath() {
+        return getPath();
+    }
+
+    std::shared_ptr<FakeJni::JString> getName() {
+        size_t pos = path.find_last_of('/');
+        std::string name = (pos == std::string::npos) ? path : path.substr(pos + 1);
+        return std::make_shared<FakeJni::JString>(name);
+    }
+
+    std::shared_ptr<FakeJni::JString> getParent() {
+        size_t pos = path.find_last_of('/');
+        if (pos == std::string::npos || pos == 0)
+            return std::make_shared<FakeJni::JString>("");
+        return std::make_shared<FakeJni::JString>(path.substr(0, pos));
+    }
+
+    FakeJni::JBoolean exists() {
+        return ::access(path.c_str(), F_OK) == 0;
+    }
+
+    FakeJni::JBoolean isDirectory() {
+        struct stat st {};
+        return ::stat(path.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+    }
+
+    FakeJni::JBoolean isFile() {
+        struct stat st {};
+        return ::stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+    }
+
+    FakeJni::JBoolean canRead() {
+        return ::access(path.c_str(), R_OK) == 0;
+    }
+
+    FakeJni::JBoolean canWrite() {
+        return ::access(path.c_str(), W_OK) == 0;
+    }
+
+    FakeJni::JLong length() {
+        struct stat st {};
+        if (::stat(path.c_str(), &st) != 0)
+            return 0;
+        return (FakeJni::JLong) st.st_size;
+    }
+
+    FakeJni::JLong lastModified() {
+        struct stat st {};
+        if (::stat(path.c_str(), &st) != 0)
+            return 0;
+        return (FakeJni::JLong) st.st_mtime * 1000LL;
+    }
+
+    FakeJni::JBoolean mkdir() {
+        bool ok = ::mkdir(path.c_str(), 0755) == 0;
+        if (storageDebug())
+            fprintf(stderr, "[storage] mkdir(%s)=%d\n", path.c_str(), (int) ok);
+        return ok;
+    }
+
+    FakeJni::JBoolean mkdirs() {
+        if (path.empty())
+            return false;
+        std::string cur;
+        bool absolute = path[0] == '/';
+        if (absolute)
+            cur = "/";
+        size_t i = absolute ? 1 : 0;
+        while (i <= path.size()) {
+            size_t slash = path.find('/', i);
+            std::string part = (slash == std::string::npos) ? path.substr(i) : path.substr(i, slash - i);
+            if (!part.empty()) {
+                if (!cur.empty() && cur.back() != '/')
+                    cur += '/';
+                cur += part;
+                if (::mkdir(cur.c_str(), 0755) != 0 && errno != EEXIST)
+                    return false;
+            }
+            if (slash == std::string::npos)
+                break;
+            i = slash + 1;
+        }
+        if (storageDebug())
+            fprintf(stderr, "[storage] mkdirs(%s)=1\n", path.c_str());
+        return true;
+    }
+
+    FakeJni::JBoolean createNewFile() {
+        int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0644);
+        if (storageDebug())
+            fprintf(stderr, "[storage] createNewFile(%s) fd=%d errno=%d\n", path.c_str(), fd, fd < 0 ? errno : 0);
+        if (fd < 0)
+            return false;
+        ::close(fd);
+        return true;
+    }
+
+    std::shared_ptr<FakeJni::JArray<FakeJni::JString>> list() {
+        std::vector<std::shared_ptr<FakeJni::JString>> names;
+        ::DIR *dir = ::opendir(path.c_str());
+        if (dir) {
+            while (struct dirent *ent = ::readdir(dir)) {
+                if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, ".."))
+                    continue;
+                names.push_back(std::make_shared<FakeJni::JString>(ent->d_name));
+            }
+            ::closedir(dir);
+        }
+        auto arr = std::make_shared<FakeJni::JArray<FakeJni::JString>>((jsize) names.size());
+        for (size_t i = 0; i < names.size(); i++)
+            (*arr)[(jint) i] = names[i];
+        if (storageDebug())
+            fprintf(stderr, "[storage] list(%s)=%zu entries\n", path.c_str(), names.size());
+        return arr;
+    }
+
+    FakeJni::JBoolean remove() {
+        bool ok = ::remove(path.c_str()) == 0;
+        if (storageDebug())
+            fprintf(stderr, "[storage] delete(%s)=%d\n", path.c_str(), (int) ok);
+        return ok;
+    }
+
+    FakeJni::JBoolean renameTo(std::shared_ptr<File> dest) {
+        if (!dest)
+            return false;
+        bool ok = ::rename(path.c_str(), dest->path.c_str()) == 0;
+        if (storageDebug())
+            fprintf(stderr, "[storage] renameTo(%s -> %s)=%d\n", path.c_str(), dest->path.c_str(), (int) ok);
+        return ok;
+    }
+
+    // Free-space queries used by UserStorageChecker. The wrapped path is a
+    // host path (built from storageDirectory); query it directly and fall
+    // back to the data dir, then to 1TiB, so storage is never reported as 0.
+    static FakeJni::JLong spaceOf(const char *label, const std::string &p, int which) {
+        struct statvfs st {};
+        if (::statvfs(p.c_str(), &st) != 0) {
+            std::string dataDir = PathHelper::getPrimaryDataDirectory();
+            if (p != dataDir && ::statvfs(dataDir.c_str(), &st) != 0) {
+                if (storageDebug())
+                    fprintf(stderr, "[storage] %s(%s)=1TiB(fallback)\n", label, p.c_str());
+                return 1024LL * 1024LL * 1024LL * 1024LL;
+            }
+        }
+        unsigned long long blocks = (which == 0) ? st.f_blocks : (which == 1) ? st.f_bfree : st.f_bavail;
+        FakeJni::JLong ret = (FakeJni::JLong) (blocks * st.f_frsize);
+        if (storageDebug())
+            fprintf(stderr, "[storage] %s(%s)=%lld\n", label, p.c_str(), (long long) ret);
+        return ret;
+    }
+
+    FakeJni::JLong getTotalSpace() {
+        return spaceOf("getTotalSpace", path, 0);
+    }
+
+    FakeJni::JLong getFreeSpace() {
+        return spaceOf("getFreeSpace", path, 1);
+    }
+
+    FakeJni::JLong getUsableSpace() {
+        return spaceOf("getUsableSpace", path, 2);
+    }
 };
 
